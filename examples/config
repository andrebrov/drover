# DROVER_REFILL_SKIP_HARNESSES="${DROVER_REFILL_SKIP_HARNESSES:-}"  # e.g. 'agy' while its quota is exhausted
# DROVER_CRED_CHECKS: extra "label|command" lines for fleet-cred-check, one per line, e.g. 'aws:prod|aws sts get-caller-identity --profile prod'
# Batch lander (fleet-batch-land): one gate run and one push for every READY branch. Opt-in: touch $FLEET_STATE/batch-land-enabled.
# DROVER_TESTDB_UP="${DROVER_TESTDB_UP:-}"            # command that prints `export NAME=value` lines for the gate's test database
