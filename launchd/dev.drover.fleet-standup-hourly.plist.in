<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.drover.fleet-standup-hourly</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BIN@/fleet-standup-auto</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@BIN@:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@LOGS@/fleet-standup-hourly.out</string>
  <key>StandardErrorPath</key>
  <string>@LOGS@/fleet-standup-hourly.err</string>
</dict>
</plist>
