#!/usr/bin/env python3
"""fleet-observe — read-only exception view of the fleet; alerts, never acts.

The observer half of "one manager" (see LESSONS.md "Two managers collide"): with `state/observer`
present, fleet-watch calls this instead of its normal dispatch/review/land lanes. It reads panes,
git and the board, and only ever calls `fleet-alert send` (deduped per key) or prints for watch.log.
It NEVER presses a key, reassigns a bean, lands or pushes.

  fleet-observe            run checks, alert on exceptions
  fleet-observe --board    print the assignment ledger (owner, bean, branch, last proof of progress)
  fleet-observe --dry      run checks, print what would alert, send nothing

See docs/RUNBOOK.md "Observer mode" for the operating model this implements.
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import time

# A timed-out child must never kill the whole observe pass: one `git merge` that hit its 30s timeout raised
# TimeoutExpired, the pass died after 1357s, and the fleet saw a 45-minute stall. Every subprocess.run in this
# file goes through this wrapper: a timeout becomes rc 124 with empty output, like coreutils `timeout`.
_run = subprocess.run


def _safe_run(*a, **kw):
    try:
        return _run(*a, **kw)
    except subprocess.TimeoutExpired as e:
        empty = '' if kw.get('text') else b''
        return subprocess.CompletedProcess(e.cmd, 124, empty, empty)


subprocess.run = _safe_run

NOW = time.time()
STALL_MIN = int(os.environ.get('FLEET_STALL_MIN', '30'))
# Optional: an hourly check for stalled scheduled jobs in your own deploy's logs. Off unless set — see
# README "Configuration". Any log source that can answer "what stalled in the last 15 minutes" fits;
# this default assumes AWS CloudWatch Logs, but the check is skipped entirely with nothing configured.
PROD_LOG_GROUP = os.environ.get('DROVER_PROD_LOG_GROUP', '')
PROD_LOG_REGION = os.environ.get('DROVER_PROD_LOG_REGION', 'us-east-1')


def drover_env():
    """The same config every bash script sees: source drover-env (next to this file) and read it back."""
    env = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'drover-env')
    out = subprocess.run(
        ['bash', '-c', '. "$0"; printf "%s\\0%s\\0%s\\0%s\\0%s\\0%s\\0%s\\0%s\\0%s\\0%s" "$DROVER_REPO" "$FLEET_TASKS" '
         '"$FLEET_REPORTS" "$FLEET_STATE" "$DROVER_HOME" "$DROVER_LEAD_SEATS" "$DROVER_SRC" '
         '"$DROVER_SELF_SERVE" "$DROVER_MIGRATIONS_STATUS" "$DROVER_OWNED_AREAS"', env],
        capture_output=True, text=True, check=True).stdout.split('\0')
    return dict(zip(('repo', 'tasks', 'reports', 'state', 'home', 'leads', 'src', 'self_serve', 'mig_status', 'owned_areas'), out))


CFG = drover_env()
REPO, TASKS, REPORTS, STATE = CFG['repo'], CFG['tasks'], CFG['reports'], CFG['state']

# Harness-level failures read off a seat's screen -> (pattern, meaning, disable the harness?).
# Add your own harness's known error text here the same way. Order matters: more specific first.
DEAD = [
    (r'Account \S+ is suspended|monthly spending limit', 'billing suspended', True),
    (r"(you'?ve|you have) hit your usage limit|usage limit reached|rate limit reached|try again at \d",
     'usage limit', True),
    (r'http_status"?:\s*402|Payment Required', 'payment required (402)', True),
    # opencode out of credits: the seat keeps status 'working' while it waits hours to retry (five seats sat ~3h unseen)
    (r'insufficient balance', 'out of credits', True),
    # ...but "Free usage exceeded" is ONE free model's cap, not the harness: alert, never disable. Disabling on it
    # switched off a whole harness whose other models still had quota.
    (r'Free usage exceeded', 'free-model usage cap hit (switch the seat to another model, or wait)', False),
    (r'keychain is locked', 'macOS login keychain locked — unlock it inside herdr (security unlock-keychain)', False),
    (r'Not logged in|Run /login|access token could not be refreshed|Please sign in again',
     'not logged in / stale login — restart the seat (a fresh process picks up the current login)', False),
    (r'open in another app', 'conversation open in another app (press R in the pane)', False),
    (r'agent executor error|write: broken pipe|request failed: Post|network issue connecting to the server',
     'transient provider/network error mid-task — its edits are in the worktree; prompt it to continue', False),
    (r'Question \d+ of \d+|How should I proceed\?',
     'waiting on a question it asked (herdr reports this as done, not blocked) — read the pane and answer', False),
    (r'not inside herdr|HERDR_ENV is not 1',
     'lost herdr context after a resume; confirm it in a prompt or relaunch the seat', False),
]


def sh(*a, timeout=20, cwd=None):
    # Own process group, killed whole on timeout: a timed-out `git fetch` left its git-remote-https child holding
    # the output pipe, subprocess.run waited on that pipe forever, and the watcher tick froze for 50 minutes.
    try:
        p = subprocess.Popen(a, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, cwd=cwd,
                             start_new_session=True)
        try:
            return p.communicate(timeout=timeout)[0]
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, 9)
            except OSError:
                pass
            p.communicate()
            return ''
    except Exception:
        return ''


def git(*a):
    return sh('git', '-C', REPO, *a).strip()


# The pane ends in the harness's own API error (the turn was dropped), not in a question or a finish.
HARNESS_ERR = re.compile(r'Something went wrong\. Please try again|stream closed with error|stream disconnected|'
                         r'API Error: (5\d\d|Overloaded|Connection)|ECONNRESET.*(anthropic|openai|cursor)', re.I)
SENT = f'{STATE}/observe-sent'   # key -> last alert epoch; one alert per key per 6h


def alert(key, title, body):
    sent = dict(l.split('\t', 1) for l in open(SENT).read().split('\n') if '\t' in l) if os.path.exists(SENT) else {}
    if key in sent and NOW - float(sent[key]) < 6 * 3600:
        return
    print(f'{key}: {title} — {body}')
    if '--dry' not in sys.argv:
        sent[key] = str(NOW)
        open(SENT, 'w').write('\n'.join(f'{k}\t{v}' for k, v in sent.items() if NOW - float(v) < 86400))
        sh(os.path.join(os.path.dirname(os.path.abspath(__file__)), 'fleet-alert'),
           'send', key, title, body, timeout=30)


def agents():
    # herdr drops a seat's name when it re-detects the agent (a fresh session, a restart): several seats went
    # unnamed at once and became unaddressable, so dispatch and prompts failed. Remember pane -> seat for every
    # named seat; rename an unnamed agent sitting on a remembered pane.
    try:
        lst = json.loads(sh('herdr', 'agent', 'list'))['result']['agents']
    except Exception:
        return {}
    mp_file = f'{STATE}/pane-seat.json'
    try:
        mp = json.load(open(mp_file))
    except Exception:
        mp = {}
    leads = set(CFG['leads'].split())
    changed = False
    for a in lst:
        n, pane = a.get('name'), a.get('pane_id')
        if n and pane and n not in leads and mp.get(pane) != n:
            mp[pane] = n; changed = True
    named = {a.get('name') for a in lst if a.get('name')}
    for a in lst:
        pane = a.get('pane_id')
        seat = mp.get(pane) if pane else None
        if not a.get('name') and seat and seat not in named and '--dry' not in sys.argv:
            r = subprocess.run(['herdr', 'agent', 'rename', pane, seat], capture_output=True, text=True, timeout=15)
            if r.returncode == 0:
                a['name'] = seat; named.add(seat); print(f'RENAMED {pane} -> {seat}')
    if changed:
        tmp = mp_file + '.tmp'; json.dump(mp, open(tmp, 'w')); os.replace(tmp, mp_file)
    return {a['name']: a for a in lst if a.get('name')}


def screen(name):
    return sh('herdr', 'agent', 'read', name, '--source', 'visible', '--lines', '40')


REPORT_OF = {}


def ledger():
    rows = []
    for seat in sorted(os.listdir(TASKS)) if os.path.isdir(TASKS) else []:
        f = os.path.join(TASKS, seat)
        parts = open(f).read().split('\t')
        bean = parts[1].strip() if len(parts) > 1 else '?'
        rows.append((seat, bean, os.path.getmtime(f)))
        if len(parts) > 3 and parts[3].strip():
            REPORT_OF[(seat, bean)] = parts[3].strip()   # the report path the assignment recorded
    return rows


def progress(seat, bean, since):
    """Newest proof of progress: a commit on the bean branch or a report file, as epoch seconds."""
    best = since
    br = f'fleet/{seat}-{bean}'
    # agents often work on suffixed branches (fleet/<seat>-<bean>-registry, -core, ...): newest commit on any
    refs = git('for-each-ref', '--sort=-committerdate', '--format=%(committerdate:unix) %(refname:short)',
               f'refs/heads/{br}', f'refs/heads/{br}-*')
    for line in refs.splitlines()[:1]:
        t, name = line.split(' ', 1)
        if t.isdigit():
            best = max(best, int(t)); br = name
    # ...and seats often name the branch after a bean they FILED, not the queue item: any commit on this seat's
    # branches made after the dispatch is progress on its current assignment (one was flagged "stalled" with
    # four fresh commits on a differently named branch).
    if best == since:
        for line in git('for-each-ref', '--sort=-committerdate', '--format=%(committerdate:unix) %(refname:short)',
                        f'refs/heads/fleet/{seat}-*').splitlines()[:1]:
            t, name = line.split(' ', 1)
            if t.isdigit() and int(t) > since:
                best = int(t); br = name
    for fn in os.listdir(REPORTS) if os.path.isdir(REPORTS) else []:
        if bean in fn and fn.endswith('.md'):
            best = max(best, os.path.getmtime(os.path.join(REPORTS, fn)))
    rp = REPORT_OF.get((seat, bean))
    if rp and os.path.exists(rp):
        best = max(best, os.path.getmtime(rp))
    return best, br


def board():
    ag = agents()
    print(f"{'seat':18} {'bean':11} {'status':8} {'last proof':>10}  branch")
    for seat, bean, t0 in ledger():
        p, br = progress(seat, bean, t0)
        st = ag.get(seat, {}).get('agent_status', 'absent')
        print(f'{seat:18} {bean:11} {st:8} {int((NOW - p) / 60):>7}min  {br}')


def check():
    ag = agents()
    off = set(open(f'{STATE}/harness-off').read().split()) if os.path.exists(f'{STATE}/harness-off') else set()

    # 1. seats: dialogs and dead harnesses (read the screen of every non-working roster seat)
    for name, a in ag.items():
        if not re.search(r'coder|reviewer|analyst', name) or a.get('agent') in off:
            continue
        st = a.get('agent_status')
        if st == 'blocked':
            alert(f'dialog-{name}', f'{name} is waiting on a dialog',
                  'Seat is blocked on an approval/question UI. Read it (herdr agent read) and answer it '
                  'deliberately; the observer never presses keys.')
        if st == 'working':
            continue
        txt = screen(name)
        for pat, what, disable in DEAD:
            if re.search(pat, txt, re.I):
                if disable and a.get('agent'):
                    with open(f'{STATE}/harness-off', 'a') as fh:
                        fh.write(a['agent'] + '\n')
                    off.add(a['agent'])
                key = f'dead-{name}-{what[:12]}-' + hashlib.md5(txt[-600:].encode()).hexdigest()[:6]
                alert(key, f'{name}: {what}',
                      f"harness {a.get('agent')} {'disabled (state/harness-off)' if disable else 'left on'}; "
                      f"its assignment is not progressing.")
                break

    # 2. finished / blocked / stalled assignments. With no inbox lane in observer mode, the seat's own report
    # is the outcome: DONE on origin -> release the seat; BLOCKED -> surface the blocker once and release; else stall.
    for seat, bean, t0 in ledger():
        if ag.get(seat, {}).get('agent') in off:
            continue   # harness switched off (billing/limit): its seat cannot progress; the dead-harness alert already fired
        p, br = progress(seat, bean, t0)
        st = ag.get(seat, {}).get('agent_status', 'absent')
        rep = REPORT_OF.get((seat, bean)) or os.path.join(REPORTS, f'{seat}-{bean}.md')
        if not os.path.exists(rep) and os.path.exists(os.path.join(REPORTS, f'{bean}.md')):
            rep = os.path.join(REPORTS, f'{bean}.md')   # seats sometimes drop the seat prefix
        if not os.path.exists(rep) and os.path.isdir(REPORTS):
            # a brief may name its own report path: take the seat's newest report written since the assignment
            # (a finished seat was flagged "stalled" 30 min after writing its report under the brief's name)
            mine = [os.path.join(REPORTS, f) for f in os.listdir(REPORTS) if f.startswith(seat + '-') and f.endswith('.md')]
            mine = [f for f in mine if os.path.getmtime(f) >= t0]
            if mine:
                rep = max(mine, key=os.path.getmtime)
        if st != 'working' and os.path.exists(rep) and os.path.getmtime(rep) >= t0:
            body = open(rep, errors='ignore').read()
            # the FIRST line is the verdict (the self-land contract's report step); a trailing "DONE <path>"
            # echo must not override a BLOCKED head.
            head = next((l for l in body.splitlines()[:3] if re.search(r'\b(DONE|BLOCKED|LANDED)\b', l)), '')
            verdict = head or next((l for l in reversed(body.strip().splitlines())
                                     if re.match(r'(DONE|BLOCKED)\b', l)), '')
            if re.match(r'\W*REVIEW-NEEDED', body):
                # the seat's cross-model reviewer failed and it handed the diff to the lead: it is WAITING, not
                # free. Releasing it here dispatched new work over a slice the lead was about to approve.
                alert(f'review-needed-{seat}-{bean}', f'{seat} needs a lead review on {bean}', body.splitlines()[0][:300])
                continue
            if 'BLOCKED' in verdict:
                why = next((l for l in body.splitlines() if re.match(r'\s*(HUMAN|LEAD|BLOCKED)[:\s]', l)), verdict)
                key = f'blocked-{seat}-{bean}-' + hashlib.md5(verdict.encode()).hexdigest()[:6]
                alert(key, f'{seat} BLOCKED on {bean}', f'{why.strip()[:300]} — report: {rep}')
                os.remove(os.path.join(TASKS, seat)); continue
            # A report with NO verdict line is a progress note, not a finish: releasing on it dispatched new work
            # over a seat mid-task. Research and verification reports lead with a verdict word too.
            if not verdict and re.search(r'^\W*(HUNT|VERDICT|COMPLETE|PASSED|[0-9]+/[0-9]+ (PASS|scenarios))',
                                         body, re.M | re.I):
                verdict = 'DONE'
            if re.match(r'\W*(PARTIAL|LANDED-PARTIAL|IN PROGRESS|WIP)\b', body):
                # PARTIAL = part landed, the rest is still this seat's work: never a release. Seats freed on PARTIAL
                # were handed self-serve rounds and walked away from their assignments.
                continue
            if re.search(r'DONE|LANDED', verdict):
                print(f'released {seat} ({bean}: {(verdict or (body.splitlines()[0] if body else ""))[:80]})')
                os.remove(os.path.join(TASKS, seat)); continue
        if st != 'working' and NOW - p > STALL_MIN * 60 and re.search(
                r'(shells?|monitors?|background terminals?) (still )?running|still running', screen(seat)):
            continue   # idle between waits on its own background jobs (herdr says "done") — busy, not stalled
        if st != 'working' and NOW - p > STALL_MIN * 60 and HARNESS_ERR.search(screen(seat)[-1500:]):
            # the harness's API dropped the turn mid-task: not a stall. One nudge to continue fixes it;
            # reassigning would throw the work away.
            alert(f'harness-err-{seat}-{bean}', f'{seat}: its harness API dropped the turn on {bean}',
                  'The pane ends in a harness/API error, not a question or a finish. Nudge it to continue from the last step.')
            continue
        if st != 'working' and NOW - p > STALL_MIN * 60:
            alert(f'stall-{seat}-{bean}', f'{seat} stalled on {bean}',
                  f'status={st}, no commit on {br} and no report for {int((NOW - p) / 60)} min. '
                  f'Read the pane, then reassign or unblock.')

    # 3. critical runnable work with no owner (queued-by-the-lead counts as owned)
    try:
        q = ('{ beans(filter:{status:["todo"], priority:["critical"], type:["bug","feature","task"], '
             'isBlocked:false}) { id title } }')
        # Read the board as it is on origin/main, not the shared checkout: the checkout lags every landing and
        # reported beans already completed on main as unowned.
        snap = f'{STATE}/beans-origin'
        sh('git', '-C', REPO, 'fetch', '-q', 'origin', timeout=60)
        # Every external step bounded: an unbounded `rm -rf` of the old snapshot hung the tick 50 minutes while
        # the disk was reclaiming 49 GB. Rename it out of the way (instant) and delete it in the background.
        if os.path.isdir(snap):
            old = f'{snap}.old.{int(NOW)}'
            os.replace(snap, old)
            subprocess.Popen(['rm', '-rf', old], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        os.makedirs(snap, exist_ok=True)
        sh('bash', '-c', f"git -C '{REPO}' archive origin/main .beans .beans.yml | tar -x -C '{snap}'", timeout=60)
        crit = json.loads(sh('beans', 'query', '--json', q, cwd=snap, timeout=30))['beans']
    except Exception:
        crit = []
    # owned = assigned on a seat, claimed through state/owner/<bean> (self-serve or lead), or queued
    owned = {b for _, b, _ in ledger()} | (set(os.listdir(f'{STATE}/owner')) if os.path.isdir(f'{STATE}/owner') else set())
    if os.path.exists(QUEUE):
        owned |= {l.split('\t')[0] for l in open(QUEUE) if l.strip()}
    free = [b['id'] for b in crit if b['id'] not in owned and not os.path.exists(f"{STATE}/noop-held/{b['id']}")]
    if free:   # ONE alert, keyed on the set, so it re-fires only when the set changes
        key = 'crit-unowned-' + hashlib.md5(' '.join(sorted(free)).encode()).hexdigest()[:8]
        alert(key, f'{len(free)} critical bean(s) with no owner', ' '.join(free))

    # 4. DONE reports that name a SHA not on origin/main (the self-land contract: pushed means on origin)
    git('fetch', '-q', 'origin', 'main')
    for fn in os.listdir(REPORTS) if os.path.isdir(REPORTS) else []:
        f = os.path.join(REPORTS, fn)
        if not fn.endswith('.md') or NOW - os.path.getmtime(f) > 6 * 3600 or '-review-' in fn:
            continue
        head = open(f, errors='ignore').read(600)
        first = head.splitlines()[0] if head else ''
        # A landing claim is a report whose FIRST LINE starts with LANDED or DONE (the verdict-word contract). Every
        # other verdict — BLOCKED, REVIEW-NEEDED, PARTIAL, a hunt — claims nothing about origin/main. The old test
        # (any "pushed"/"DONE" in the head, minus a list of negative phrases) raised four false alarms in one day.
        if not re.match(r'\W*(LANDED|DONE)\b', first):
            continue
        owner = next((n for n in ag if fn.startswith(n + '-')), None)
        if owner and ag[owner].get('agent_status') == 'working':
            continue   # its owner is still on it (e.g. mid-rebase/push) — alert only once the seat stops
        m = re.search(r'\b([0-9a-f]{9,40})\b', head)
        if m and subprocess.run(['git', '-C', REPO, 'merge-base', '--is-ancestor', m.group(1), 'origin/main'],
                                 capture_output=True).returncode != 0:
            if git('cat-file', '-t', m.group(1)) == 'commit':
                alert(f'notpushed-{fn}', f'{fn}: claims landed but {m.group(1)} is not on origin/main',
                      'The self-land contract: DONE means the SHA is an ancestor of origin/main. Send it back.')

    # 4b. hand queued work to free seats
    dispatch(ag, off)

    # 4c. optional: migrations on main but not applied (hourly). A "migration NNN needs applying" line in a report
    # was the only signal, and migrations sat unapplied while the code that needs them was live.
    # DROVER_MIGRATIONS_STATUS = a command run in DROVER_REPO that prints one "PENDING <number>_<name>" per
    # unapplied migration. state/migrations-held: one per line, first token the number, the rest the reason.
    if CFG['mig_status']:
        mstamp = f'{STATE}/observe-migrations.stamp'
        if not os.path.exists(mstamp) or NOW - os.path.getmtime(mstamp) > 3600:
            open(mstamp, 'w').write(str(int(NOW)))
            hf = f'{STATE}/migrations-held'
            held = {l.split()[0] for l in open(hf) if l.split()} if os.path.exists(hf) else set()
            out = sh('bash', '-c', CFG['mig_status'], cwd=REPO, timeout=180)
            pend = [m for m in re.findall(r'PENDING (\d+)_\S+', out) if m not in held]
            if pend:
                alert('migrations-pending-' + '-'.join(pend), f'{len(pend)} migration(s) on main not applied: {" ".join(pend)}',
                      'Code that needs them may already be deployed. Review each and apply, '
                      'or add it to state/migrations-held with a reason.')

    # 4d. keep the shared checkout's main current. Hooks that measure LOCAL main refused good pushes while it sat
    # far behind, because the old fast-forward swallowed its own failure.
    git('fetch', '-q', 'origin')
    if git('rev-parse', '--abbrev-ref', 'HEAD') == 'main' and git('rev-list', '--count', 'main..origin/main') not in ('', '0'):
        r = subprocess.run(['git', '-C', REPO, 'merge', '-q', '--ff-only', 'origin/main'], capture_output=True, text=True)
        lock = f'{REPO}/.git/index.lock'
        if r.returncode != 0 and 'index.lock' in r.stderr and (not os.path.exists(lock) or NOW - os.path.getmtime(lock) < 600):
            pass   # a live git op holds the lock and frees it in seconds; only a lock older than 10 min is stuck
        elif r.returncode != 0:
            blockers = re.findall(r'^\t(\S+)', r.stderr, re.M)[:6]
            alert('main-ff-blocked-' + time.strftime('%Y%m%d%H'), 'shared checkout main cannot fast-forward',
                  f'{git("rev-list", "--count", "main..origin/main")} behind; blocked by: '
                  + (', '.join(blockers) or r.stderr.strip()[:200])
                  + '. Compare each with origin/main; move identical or stale copies aside, then fast-forward.')

    # 4e. bean files created in the SHARED checkout instead of a seat worktree are invisible to dispatch and to
    # every other seat until someone commits them.
    stray = [l[3:] for l in git('status', '--porcelain', '--untracked-files=all', '--', '.beans').splitlines()
             if l.startswith('?? ')]
    if stray:
        alert('stray-beans-' + hashlib.md5(' '.join(sorted(stray)).encode()).hexdigest()[:8],
              f'{len(stray)} bean file(s) uncommitted in the shared checkout',
              'Not on main, so dispatch cannot see them: ' + ', '.join(os.path.basename(x)[:40] for x in stray[:6])
              + ('…' if len(stray) > 6 else '') + '. Have the filing seat commit them from its worktree and push.')

    # 5. optional: production scheduled jobs stalled (hourly; skipped with no DROVER_PROD_LOG_GROUP)
    if PROD_LOG_GROUP:
        stamp = f'{STATE}/observe-prod.stamp'
        if not os.path.exists(stamp) or NOW - os.path.getmtime(stamp) > 3600:
            open(stamp, 'w').write(str(int(NOW)))
            out = sh('aws', 'logs', 'filter-log-events', '--region', PROD_LOG_REGION,
                      '--log-group-name', PROD_LOG_GROUP, '--start-time', str(int((NOW - 900) * 1000)),
                      '--filter-pattern', '"has not completed since"',
                      '--query', 'events[].message', '--output', 'text', timeout=60)
            jobs = sorted(set(re.findall(r'job \\?"([a-z0-9-]+)\\?" has not completed', out)))
            if jobs:
                alert('prod-jobs-stalled', f'{len(jobs)} production scheduled jobs stalled',
                      ', '.join(jobs[:12]) + (' …' if len(jobs) > 12 else ''))


# --- lead queue ---------------------------------------------------------------------------------------
# ONE manager: the lead writes the ORDER (state/lead-queue); this only hands the next line to a free seat,
# so no seat waits on the lead's next message. Line format: <bean>\t<harnesses: claude,cursor,agy | *>\t<prompt>
# Pool = seats allowed to take queued work (state/lead-pool, one seat name per line, optionally `name:named`
# to mean "only take a line that names this seat explicitly", for a seat with a narrower remit).
QUEUE = f'{STATE}/lead-queue'
POOL = f'{STATE}/lead-pool'
# Harnesses that pick their own work when nothing queued fits them (DROVER_SELF_SERVE, e.g. "opencode"), per
# docs/self-serve-playbook.md. Seats on cheap or free models otherwise sat idle beside a queue routed elsewhere.
SELF_SERVE = set(CFG['self_serve'].split())
# Areas owned by a single seat (DROVER_OWNED_AREAS, space-separated `area:owner-seat`, e.g. 'billing:billing-reviewer').
# A scope decision has to reach EVERY prompt source the same hour — role playbooks AND this generated prompt: when
# only the playbooks said it, three self-serving seats drifted into the owned area from this prompt's text.
OWNED = [x.split(':', 1) for x in CFG['owned_areas'].split() if ':' in x]


def owned_exclusion(seat):
    areas = [f'{area} (owned by {owner})' for area, owner in OWNED if owner != seat]
    return (' NEVER take a bean in these single-owner areas: ' + ', '.join(areas) + '.') if areas else ''
PLAYBOOK = os.path.join(CFG['src'], 'docs', 'self-serve-playbook.md')


def dispatch(ag, off):
    if not os.path.exists(QUEUE) or not os.path.exists(POOL):
        return
    pool_raw = [l.strip() for l in open(POOL) if l.strip()]
    pool = [l.split(':')[0] for l in pool_raw]
    named_only = {l.split(':')[0] for l in pool_raw if l.endswith(':named')}
    lines = [l.rstrip('\n') for l in open(QUEUE) if l.strip()]
    held = {seat for seat, _, _ in ledger()}
    idle = []
    for seat in pool:
        a = ag.get(seat)
        if not a or a.get('agent') in off or seat in held or a.get('agent_status') not in ('idle', 'done'):
            continue
        pick = next((i for i, l in enumerate(lines)
                     if len(l.split('\t')) >= 3 and (
                         (seat in l.split('\t')[1].split(','))
                         if seat in named_only else
                         (l.split('\t')[1] == '*' or a.get('agent') in l.split('\t')[1].split(',')
                          or seat in l.split('\t')[1].split(','))
                     )), None)
        if pick is None:
            # throttled per seat, so a seat that finds nothing is not re-prompted every tick
            stamp = f'{STATE}/self-serve-{seat}.stamp'
            if a.get('agent') in SELF_SERVE and (not os.path.exists(stamp) or NOW - os.path.getmtime(stamp) > 1200):
                open(stamp, 'w').write(str(int(NOW)))
                lines.append(f'self-serve\t{seat}\tSelf-serve: read and follow {PLAYBOOK} section "Self-serve" '
                             '(pick an unowned ready bean in scope and land it, or run one hunt).' + owned_exclusion(seat))
                pick = len(lines) - 1
            else:
                idle.append(seat); continue
        bean, _, prompt = lines.pop(pick).split('\t', 2)
        rep = os.path.join(REPORTS, f'{seat}-{bean}.md')
        open(os.path.join(TASKS, seat), 'w').write(f'{int(NOW)}\t{bean}\tnone\t{rep}\n')
        if bean == 'self-serve' and a.get('agent') == 'opencode':
            # each self-serve round starts in a FRESH opencode session (`/new` keeps the model): rounds piled up
            # in one session until its context ran out mid-bean. herdr sees the new session as a new agent and
            # drops the seat name, so re-assert it on the same pane.
            pane = a.get('pane_id')
            subprocess.run(['herdr', 'agent', 'prompt', seat, '/new'], capture_output=True, text=True, timeout=30)
            time.sleep(3)
            if pane:
                subprocess.run(['herdr', 'agent', 'rename', pane, seat], capture_output=True, text=True, timeout=15)
        r = subprocess.run(
            ['herdr', 'agent', 'prompt', seat, prompt + f' Report to {rep} (first line = verdict + pushed SHA).'],
            capture_output=True, text=True, timeout=60)
        if r.returncode != 0:   # a failed send puts the work back (never claim what did not start)
            os.remove(os.path.join(TASKS, seat)); lines.insert(pick, f'{bean}\t*\t{prompt}')
            print(f'DISPATCH-FAILED {seat} {bean}'); continue
        print(f'DISPATCH {bean} -> {seat}')
    open(QUEUE, 'w').write(''.join(l + '\n' for l in lines))
    if len(idle) >= 2:   # not only when the queue is EMPTY: idle seats beside a queue none may take stayed silent
        alert('queue-empty-' + time.strftime('%Y%m%d%H'), f'{len(idle)} seats idle, nothing in the lead queue they may take',
              f'Idle: {" ".join(idle)}. Queue holds {len(lines)} line(s) routed elsewhere. Fill or re-route {QUEUE}.')


if __name__ == '__main__':
    board() if '--board' in sys.argv else check()
