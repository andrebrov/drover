#!/usr/bin/env python3
"""Fleet observer: native pane advice, bounded children and origin ancestry for completion.

2026-10-18: pane status is advisory; missing evidence never releases task ownership.
"""

import sys as _fleet_sys
from pathlib import Path as _FleetPath
_fleet_sys.path.insert(0, str(_FleetPath(__file__).resolve().parents[1] / "lib"))
from fleet_config import configure
config=configure(export=__name__=="__main__")
from fleet_usage import gate as _fleet_gate
_fleet_gate(_fleet_sys.argv, __file__)

from fleet_delivery import delivery_gate, Held, delivered, transport

import contextlib
import hashlib
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor


HOME = os.path.expanduser("~")
TASKS = config['FLEET_TASKS']
REPORTS = config['FLEET_REPORTS']
STATE = config['FLEET_STATE']
REPO = config.get('DROVER_REPO') or config.get('FLEET_ROOT') or os.getcwd()
SENT = f"{STATE}/observe-sent"
PANE_CACHE = f"{STATE}/observe-pane-jev.json"
QUEUE = f"{STATE}/lead-queue"
POOL = f"{STATE}/lead-pool"
PANE_JUDGE = config.get("FLEET_PANE_JUDGE", os.path.join(os.path.dirname(__file__), "fleet-pane-judge"))
STALL_MIN = int(config.get("FLEET_STALL_MIN", "30"))
PROD_GROUP = config.get("DROVER_PROD_LOG_GROUP", "")
NOW = time.time()
DRY = "--dry" in sys.argv
REPORT_OF = {}


def sh(*args, timeout=20, cwd=None, input_text=None):
    try:
        # A descendant retaining the pipe must not survive a timed-out fetch/judge.
        process = subprocess.Popen(args, stdin=subprocess.PIPE if input_text is not None else None,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                   cwd=cwd, start_new_session=True)
        try:
            return process.communicate(input=input_text, timeout=timeout)[0]
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.communicate()
            return ""
    except Exception:
        return ""


def git(*args):
    return sh("git", "-C", REPO, *args).strip()


def alert(key, title, body):
    if os.path.exists(SENT):
        with open(SENT) as handle:
            sent = dict(line.split("\t", 1) for line in handle if "\t" in line)
    else:
        sent = {}
    if key in sent and NOW - float(sent[key]) < 6 * 3600:
        return
    print(f"{key}: {title} — {body}")
    if not DRY:
        sent[key] = str(NOW)
        with open(SENT, "w") as handle:
            handle.write("\n".join(f"{k}\t{v}" for k, v in sent.items() if NOW - float(v) < 86400))
        sh(os.path.join(config["DROVER_BIN"], "fleet-alert"), "send", key, title, body, timeout=30)


def agents():
    try:
        roster = json.loads(sh("herdr", "agent", "list", timeout=60))["result"]["agents"]
        path = os.path.join(STATE, "pane-seat.json")
        try:
            with open(path) as handle:
                remembered = json.load(handle)
            if not isinstance(remembered, dict):
                remembered = {}
        except (OSError, ValueError):
            remembered = {}
        changed = False
        for agent in roster:
            name, pane = agent.get("name"), agent.get("pane_id")
            if name and pane and name in {s.split(":")[0] for s in config["DROVER_ROSTER"].split()} and name not in config["DROVER_LEAD_SEATS"].split() and remembered.get(pane) != name:
                remembered[pane] = name
                changed = True
        named = {agent.get("name") for agent in roster if agent.get("name")}
        for agent in roster:
            pane = agent.get("pane_id")
            name = remembered.get(pane)
            if not agent.get("name") and name and name not in named and not DRY:
                try:
                    result = subprocess.run(["herdr", "agent", "rename", pane, name], capture_output=True, timeout=15)
                    if result.returncode == 0:
                        agent["name"] = name
                        named.add(name)
                except subprocess.TimeoutExpired:
                    pass
        if changed and not DRY:
            os.makedirs(STATE, exist_ok=True)
            with tempfile.NamedTemporaryFile("w", dir=STATE, delete=False) as handle:
                json.dump(remembered, handle)
                temporary = handle.name
            os.replace(temporary, path)
        return {agent["name"]: agent for agent in roster if agent.get("name")}
    except Exception:
        return {}


def screen(name):
    return sh("herdr", "agent", "read", name, "--source", "visible", "--lines", "40")


def ledger():
    rows = []
    for seat in sorted(os.listdir(TASKS)) if os.path.isdir(TASKS) else []:
        path = os.path.join(TASKS, seat)
        if seat.startswith(".") or not os.path.isfile(path):
            continue
        with open(path) as handle:
            parts = handle.read().split("\t")
        bean = parts[1].strip() if len(parts) > 1 else "?"
        rows.append((seat, bean, os.path.getmtime(path)))
        if len(parts) > 3 and parts[3].strip():
            REPORT_OF[(seat, bean)] = parts[3].strip()
    return rows


def progress(seat, bean, since):
    best, branch = since, f"fleet/{seat}-{bean}"
    refs = git("for-each-ref", "--sort=-committerdate", "--format=%(committerdate:unix) %(refname:short)",
               f"refs/heads/{branch}", f"refs/heads/{branch}-*")
    for line in refs.splitlines()[:1]:
        stamp, name = line.split(" ", 1)
        if stamp.isdigit():
            best, branch = max(best, int(stamp)), name
    if best == since:
        refs = git("for-each-ref", "--sort=-committerdate", "--format=%(committerdate:unix) %(refname:short)",
                   f"refs/heads/fleet/{seat}-*")
        for line in refs.splitlines()[:1]:
            stamp, name = line.split(" ", 1)
            if stamp.isdigit() and int(stamp) > since:
                best, branch = int(stamp), name
    for filename in os.listdir(REPORTS) if os.path.isdir(REPORTS) else []:
        if bean in filename and filename.endswith(".md"):
            best = max(best, os.path.getmtime(os.path.join(REPORTS, filename)))
    report = REPORT_OF.get((seat, bean))
    if report and os.path.exists(report):
        best = max(best, os.path.getmtime(report))
    return best, branch


LIVE_ACTIVITY = re.compile(
    r"\b(Working|Waiting for background terminal|Thinking|Exploring|Streaming)"
    # Identical to fleet-pane-judge's rule; a drift test asserts the two agree,
    # and a mismatch would re-hash a parked pane on every tick.
    r" \((\d+h\s*)?(\d+m\s*)?(\d+s)?(?=\s*(?:•|\)))"
)


def pane_fingerprint(text):
    # A running timer changes every tick but is not a new state. Do not cache
    # pane text itself; only a hash of its stable visible content. Only the
    # elapsed timer after a live-activity label is erased: "Worked for 2h 6m
    # 11s" is what marks a turn finished and must stay in the hash.
    stable = LIVE_ACTIVITY.sub(lambda m: f"{m.group(1)} (TIME", text)
    stable = re.sub(r"[⠁-⣿]*\s*Running [\d.]+[kKmM]? tokens", "Running COUNT tokens", stable)
    return hashlib.sha256(stable.encode("utf-8", errors="replace")).hexdigest()


def classify_changed(seat, pane, cache, judge):
    if not pane.strip():
        return {"state": "unknown", "confidence": 0.0, "reason": "empty_pane"}
    digest = pane_fingerprint(pane)
    prior = cache.get(seat)
    if isinstance(prior, dict) and prior.get("hash") == digest and isinstance(prior.get("result"), dict):
        try:
            unchanged = max(0, NOW - float(prior.get("observed_at", NOW)))
        except (TypeError, ValueError):
            unchanged = 0
        # A cache row written before the push-claim Noul was dropped still
        # carries claims_pushed_probability; never hand a retired key back out.
        carried = {k: v for k, v in prior["result"].items() if k != "claims_pushed_probability"}
        return {**carried, "pane_unchanged_seconds": unchanged}
    try:
        result = judge(pane)
        if result.get("state") not in ("working", "waiting_on_question", "provider_error", "stuck_loop", "finished", "unknown"):
            raise ValueError("invalid pane decision")
    except Exception:
        result = {"state": "unknown", "confidence": 0.0, "reason": "judge_unavailable"}
    cache[seat] = {"hash": digest, "result": result, "observed_at": NOW}
    return {**result, "pane_unchanged_seconds": 0}


def call_pane_judge(pane):
    result = sh(PANE_JUDGE, timeout=8, input_text=json.dumps({"pane_text": pane}))
    try:
        return json.loads(result)
    except ValueError:
        return {"state": "unknown", "confidence": 0.0, "reason": "judge_unavailable"}


def pane_states(roster):
    try:
        if os.path.exists(PANE_CACHE):
            with open(PANE_CACHE) as handle:
                cache = json.load(handle)
        else:
            cache = {}
        if not isinstance(cache, dict):
            cache = {}
    except (OSError, ValueError):
        cache = {}
    cache = {seat: entry for seat, entry in cache.items()
             if isinstance(entry, dict) and isinstance(entry.get("hash"), str)
             and isinstance(entry.get("result"), dict)}
    seats = [name for name in roster if re.search(r"coder|reviewer|analyst", name)]
    with ThreadPoolExecutor(max_workers=12) as pool:
        panes = dict(zip(seats, pool.map(screen, seats)))
        changed = [name for name in seats if panes[name].strip() and
                   cache.get(name, {}).get("hash") != pane_fingerprint(panes[name])]
        fresh = dict(zip(changed, pool.map(call_pane_judge, (panes[name] for name in changed))))
    decisions = {name: classify_changed(name, panes[name], cache,
                                        lambda _, n=name: fresh[n]) for name in seats}
    if not DRY:
        os.makedirs(STATE, exist_ok=True)
        with tempfile.NamedTemporaryFile("w", dir=STATE, prefix="observe-pane-", delete=False) as handle:
            json.dump(cache, handle, sort_keys=True)
            temp = handle.name
        os.replace(temp, PANE_CACHE)
    return decisions


def completion_proof(report_text, is_ancestor):
    """A report or pane claim is never proof without an origin/main SHA check."""
    first = report_text.splitlines()[0].strip() if report_text.splitlines() else ""
    if re.match(r"^BLOCKED\b", first):
        return "blocked"
    if not re.match(r"^(?:DONE|LANDED|APPROVE)\b", first):
        return "none"
    match = re.search(r"\b[0-9a-f]{9,40}\b", first)
    if not match:
        return "not_pushed"
    return "landed" if is_ancestor(match.group()) else "not_pushed"


def on_origin(sha):
    try:
        return subprocess.run(["git", "-C", REPO, "merge-base", "--is-ancestor", sha, "origin/main"],
                              capture_output=True, timeout=10).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def board():
    roster = agents()
    print(f"{'seat':18} {'bean':11} {'status':8} {'last proof':>10}  branch")
    for seat, bean, start in ledger():
        proof, branch = progress(seat, bean, start)
        status = roster.get(seat, {}).get("agent_status", "absent")
        print(f"{seat:18} {bean:11} {status:8} {int((NOW - proof) / 60):>7}min  {branch}")


def dispatch(roster, off):
    if not os.path.exists(QUEUE) or not os.path.exists(POOL):
        return
    with open(POOL) as handle:
        pool_raw = [line.strip() for line in handle if line.strip()]
    pool = [line.split(":")[0] for line in pool_raw]
    named_only = {line.split(":")[0] for line in pool_raw if line.endswith(":named")}
    with open(QUEUE) as handle:
        lines = [line.rstrip("\n") for line in handle if line.strip()]
    assignments = ledger()
    held = {seat for seat, _, _ in assignments}
    taken = {bean for _, bean, _ in assignments}
    owner_dir = os.path.join(STATE, "owner")
    if os.path.isdir(owner_dir):
        taken.update(os.listdir(owner_dir))
    lines = [line for line in lines if line.split("\t", 1)[0] == "self-serve" or
             line.split("\t", 1)[0] not in taken]
    idle = []
    for seat in pool:
        agent = roster.get(seat)
        if not agent or agent.get("agent") in off or seat in held or agent.get("agent_status") not in ("idle", "done"):
            continue
        pick = next((i for i, line in enumerate(lines)
                     if len(line.split("\t")) >= 3 and
                     ((seat in line.split("\t")[1].split(",")) if seat in named_only else
                      (line.split("\t")[1] == "*" or agent.get("agent") in line.split("\t")[1].split(",") or
                       seat in line.split("\t")[1].split(",")))), None)
        if pick is None:
            idle.append(seat)
            continue
        bean, target, prompt = lines.pop(pick).split("\t", 2)
        report = os.path.join(REPORTS, f"{seat}-{bean}.md")
        if DRY:
            print(f"WOULD-DISPATCH {bean} -> {seat}")
            continue
        try:
            with delivery_gate(seat) as target_pane:
                with open(os.path.join(TASKS, seat), "w") as handle:
                    handle.write(f"{int(NOW)}\t{bean}\tnone\t{report}\n")
                outcome = subprocess.run([transport(), "agent", "prompt", target_pane["pane_id"],
                                          prompt + f" Report to {report} (first line = verdict + pushed SHA).",
                                          "--wait", "--until", "working", "--timeout", "10000"],
                                         capture_output=True, text=True, timeout=60)
        except Held as hold:
            lines.insert(pick, f"{bean}\t{target}\t{prompt}")
            print(f"HOLD delivery {seat}: {hold.reason}")
            continue
        if outcome.returncode != 0 or not delivered(outcome.stdout, target_pane):
            # A transport failure can occur after typing. Keep the task and do
            # not requeue: a human must inspect before any retry.
            print(f"UNKNOWN_DELIVERY {seat} {bean}; task retained, no blind resend")
            continue
        print(f"DISPATCH {bean} -> {seat}")
    if not DRY:
        with open(QUEUE, "w") as handle:
            handle.write("".join(line + "\n" for line in lines))
    if len(idle) >= 2:
        alert("queue-empty-" + time.strftime("%Y%m%d%H"), f"{len(idle)} seats idle, nothing in the lead queue they may take",
              "Idle: " + " ".join(idle) + f". Queue holds {len(lines)} line(s) routed elsewhere.")


def check():
    roster = agents()
    if not roster:
        print("herdr agent list unreadable this tick; seat checks skipped")
        return
    off = set(open(f"{STATE}/harness-off").read().split()) if os.path.exists(f"{STATE}/harness-off") else set()
    assignments = ledger()
    decisions = pane_states(roster)
    # Refresh before evaluating any report SHA. A stale remote-tracking ref
    # must not create a false not-pushed alert or delay a valid release.
    git("fetch", "-q", "origin", "main")
    reap_owners()

    # Jev choices alert only. They never disable a harness, answer a dialog, or
    # clear an assignment. No regex scans the pane for a dead/status signature.
    for seat, result in decisions.items():
        if roster[seat].get("agent") in off:
            continue
        state = result["state"]
        if state == "waiting_on_question":
            alert(f"dialog-{seat}", f"{seat} is waiting on a question",
                  "Read the pane and answer deliberately; the observer never presses keys.")
        elif state == "provider_error":
            alert(f"provider-{seat}", f"{seat} has a provider/session error",
                  "Read the current pane; its assignment is not progressing. Harness remains enabled.")
        elif state == "stuck_loop":
            alert(f"loop-{seat}", f"{seat} is stuck in a loop", "Read the current pane and route a fix; no automatic action was taken.")
        elif state == "unknown":
            alert(f"pane-uncertain-{seat}", f"{seat} pane state unverified", "Jev unavailable or uncertain; inspect the pane. No completion action taken.")

    # Assignment state: a Jev 'finished' answer merely selects a candidate.
    # Report freshness plus SHA ancestry are the independent release proof.
    for seat, bean, start in assignments:
        if roster.get(seat, {}).get("agent") in off:
            continue
        if bean.endswith(("-standby", "-waiting")):
            continue
        proof, branch = progress(seat, bean, start)
        state = decisions.get(seat, {}).get("state", "unknown")
        report = REPORT_OF.get((seat, bean)) or os.path.join(REPORTS, f"{seat}-{bean}.md")
        if not os.path.exists(report) and os.path.isfile(os.path.join(REPORTS, f"{bean}.md")):
            report = os.path.join(REPORTS, f"{bean}.md")
        report_is_fresh = os.path.exists(report) and os.path.getmtime(report) >= start
        # Jev can abstain or be down. A fresh report plus origin/main ancestry
        # is independent mechanical proof, so never gate release on its Choice.
        if report_is_fresh:
            with open(report, errors="replace") as handle:
                body = handle.read(2000)
            outcome = completion_proof(body, on_origin)
            if outcome == "blocked":
                alert(f"blocked-{seat}-{bean}-" + hashlib.md5(body.splitlines()[0].encode()).hexdigest()[:6],
                      f"{seat} BLOCKED on {bean}", f"Report: {report}")
                if not DRY:
                    os.remove(os.path.join(TASKS, seat))
                continue
            if outcome == "landed":
                print(f"released {seat} ({bean}: ancestry-proven on origin/main)")
                if not DRY:
                    os.remove(os.path.join(TASKS, seat))
                continue
            if outcome == "not_pushed":
                alert(f"notpushed-{seat}-{bean}", f"{seat} claims DONE on {bean} without ancestry proof",
                      f"Report {report} names no SHA on origin/main. Keep assignment until verified.")
        if state == "finished" and NOW - proof > STALL_MIN * 60:
            alert(f"stall-{seat}-{bean}", f"{seat} finished without a proven report for {bean}",
                  f"No commit/report proof for {int((NOW - proof) / 60)} min on {branch}; inspect and route.")
        if (state == "working" and NOW - proof > STALL_MIN * 60 and
                decisions.get(seat, {}).get("pane_unchanged_seconds", 0) > STALL_MIN * 60):
            alert(f"stale-working-{seat}-{bean}", f"{seat} working pane has no new content for {bean}",
                  f"Pane and commit/report proof unchanged for {STALL_MIN}+ min on {branch}; inspect manually.")

    critical_work(assignments)

    # Mechanical completion audit is separate from Jev. origin/main ancestry is
    # the only release signal; no pane claim can waive it.
    for filename in os.listdir(REPORTS) if os.path.isdir(REPORTS) else []:
        path = os.path.join(REPORTS, filename)
        if not filename.endswith(".md") or NOW - os.path.getmtime(path) > 6 * 3600 or "-review-" in filename:
            continue
        with open(path, errors="replace") as handle:
            head = handle.read(600)
        if completion_proof(head, on_origin) != "not_pushed":
            continue
        if re.match(r"^(?:DONE|LANDED|APPROVE)\b", head):
            alert(f"notpushed-{filename}", f"{filename}: claims landed without origin/main proof",
                  "Self-land contract: DONE requires a SHA ancestor of origin/main. Send it back.")

    dispatch(roster, off)
    migration_health()
    shared_checkout_health()

    stamp = f"{STATE}/observe-prod.stamp"
    if PROD_GROUP and (not os.path.exists(stamp) or NOW - os.path.getmtime(stamp) > 3600):
        if not DRY:
            with open(stamp, "w") as handle:
                handle.write(str(int(NOW)))
        output = sh("aws", "logs", "filter-log-events", "--region", "us-east-1", "--log-group-name", PROD_GROUP,
                    "--start-time", str(int((NOW - 900) * 1000)), "--filter-pattern", '"has not completed since"',
                    "--query", "events[].message", "--output", "text", timeout=60)
        jobs = sorted(set(re.findall(r'job \\?"([a-z0-9-]+)\\?" has not completed', output)))
        if jobs:
            alert("prod-jobs-stalled", f"{len(jobs)} production scheduled jobs stalled",
                  ", ".join(jobs[:12]) + (" …" if len(jobs) > 12 else ""))

    # Check if production is behind origin/main for > 30 minutes (bean-q54z)
    try:
        health_url = config.get("APPRUNNER_HEALTH_URL", config.get("DROVER_PROD_VERSION_URL", ""))
        health_raw = sh("curl", "-fsS", "-m", "10", health_url)
        live_sha = None
        live_build = {}
        if health_raw:
            try:
                data = json.loads(health_raw)
                live_build = data.get("build", {})
                live_sha = live_build.get("sha")
            except Exception:
                live_sha = None
                live_build = {}
        tip_raw = git("ls-remote", "origin", "refs/heads/main")
        match = re.match(r"^([0-9a-f]{40})\b", tip_raw.strip()) if tip_raw else None
        tip = match.group(1) if match else None
        if not tip:
            alert("prod-remote-check-failed", "cannot resolve tip of origin/main via ls-remote",
                  "git ls-remote failed; retaining divergence state without declaring convergence")
        else:
            behind = check_production_behind(live_sha, tip, NOW, live_build=live_build)
            if behind:
                live_label = behind['live'][:7] if behind['live'] else 'unknown'
                alert("prod-behind-main", "production behind origin/main > 30 min",
                      f"Live is {live_label}, tip is {behind['tip'][:7]} ({behind['minutes_behind']}m behind). "
                      f"Oldest undeployed commit {behind['oldest_sha'][:7]}. "
                      f"Deployer may be down or paused.")
    except Exception as e:
        alert("prod-behind-error", "production behind check error", str(e))


def reap_owners():
    """A lagging shared checkout is not evidence that a new bean disappeared."""
    directory = os.path.join(STATE, "owner")
    if not os.path.isdir(directory):
        return
    beans = os.path.join(REPO, ".beans")
    names = os.listdir(beans) if os.path.isdir(beans) else []
    origin = None
    for bean in os.listdir(directory):
        filename = next((name for name in names if name.startswith(bean + "--")), None)
        status = None
        if filename:
            with open(os.path.join(beans, filename), errors="replace") as handle:
                match = re.search(r"^status:\s*(\S+)", handle.read(), re.M)
            status = match.group(1) if match else None
        else:
            if origin is None:
                origin = git("ls-tree", "-r", "--name-only", "origin/main", ".beans")
            # Empty output includes an unavailable git query: retain ownership.
            if not origin or any(path.startswith(f".beans/{bean}--") for path in origin.splitlines()):
                continue
        if not filename or status in ("completed", "scrapped"):
            print(f"owner reaped {bean} ({status or 'no bean file'})")
            if not DRY:
                target = os.path.join(config["DROVER_HOME"], "handoffs/owner-reaped")
                os.makedirs(target, exist_ok=True)
                os.replace(os.path.join(directory, bean), os.path.join(target, bean))


def critical_work(assignments):
    try:
        os.makedirs(STATE, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix="beans-origin-", dir=STATE) as snapshot:
            command = f"git -C {shlex.quote(REPO)} archive origin/main .beans .beans.yml | tar -x -C {shlex.quote(snapshot)}"
            sh("bash", "-o", "pipefail", "-c", command, timeout=60)
            if not os.path.isdir(os.path.join(snapshot, ".beans")) or not os.path.isfile(os.path.join(snapshot, ".beans.yml")):
                return
            query = '{ beans(filter:{status:["todo"], priority:["critical"], type:["bug","feature","task"], isBlocked:false}) { id title } }'
            critical = json.loads(sh("beans", "query", "--json", query, cwd=snapshot, timeout=30))["beans"]
    except (OSError, ValueError, KeyError):
        return
    owned = {bean for _, bean, _ in assignments}
    directory = os.path.join(STATE, "owner")
    if os.path.isdir(directory):
        owned.update(os.listdir(directory))
    if os.path.exists(QUEUE):
        with open(QUEUE) as handle:
            owned.update(line.split("\t")[0] for line in handle if line.strip())
    free = [bean["id"] for bean in critical if bean["id"] not in owned and
            not os.path.exists(f"{STATE}/noop-held/{bean['id']}")]
    if free:
        key = "crit-unowned-" + hashlib.md5(" ".join(sorted(free)).encode()).hexdigest()[:8]
        alert(key, f"{len(free)} critical bean(s) with no owner", " ".join(free))


def migration_health():
    stamp = os.path.join(STATE, "observe-migrations.stamp")
    if os.path.exists(stamp) and NOW - os.path.getmtime(stamp) < 3600:
        return
    if not DRY:
        os.makedirs(STATE, exist_ok=True)
        with open(stamp, "w") as handle:
            handle.write(str(int(NOW)))
    held_file = os.path.join(STATE, "migrations-held")
    with open(held_file) if os.path.exists(held_file) else contextlib.nullcontext([]) as handle:
        held = {line.split()[0] for line in handle if line.split()}
    # Read status only; never merge a checkout or apply a migration from this check.
    command = config.get('DROVER_MIGRATIONS_STATUS', '')
    if not command:
        return
    command = 'export PGOPTIONS="${PGOPTIONS:-} -c default_transaction_read_only=on"; ' + command
    output = sh("bash", "-c", command, cwd=REPO, timeout=180)
    if not output.strip():
        alert("migrations-status-unavailable", "migration status unavailable", "Status query returned no evidence; no migration was applied.")
        return
    pending = [n for n in re.findall(r"PENDING (\d+)_\S+", output) if n not in held]
    if pending:
        alert("migrations-pending-" + "-".join(pending), f"{len(pending)} migration(s) on main not applied",
              " ".join(pending) + ". Lead: review/apply or record a reason in state/migrations-held.")


def shared_checkout_health():
    if git("rev-parse", "--abbrev-ref", "HEAD") == "main" and git("rev-list", "--count", "main..origin/main") not in ("", "0") and not DRY:
        try:
            result = subprocess.run(["git", "-C", REPO, "merge", "-q", "--ff-only", "origin/main"], capture_output=True, text=True, timeout=30)
            lock = os.path.join(REPO, ".git/index.lock")
            transient_lock = "index.lock" in result.stderr and (not os.path.exists(lock) or NOW-os.path.getmtime(lock)<600)
            if result.returncode != 0 and not transient_lock:
                alert("main-ff-blocked-" + time.strftime("%Y%m%d%H"), "shared checkout main cannot fast-forward", result.stderr[:300])
        except subprocess.TimeoutExpired:
            alert("main-ff-timeout", "shared checkout fast-forward timed out", "Inspect the shared checkout; the observer pass continues.")
    stray = []
    for line in git("status", "--porcelain", "--untracked-files=all", "--", ".beans").splitlines():
        if line.startswith("?? "):
            path = os.path.join(REPO, line[3:])
            if os.path.isfile(path) and NOW-os.path.getmtime(path)>900:
                stray.append(line[3:])
    if stray:
        alert("stray-beans-" + hashlib.md5(" ".join(sorted(stray)).encode()).hexdigest()[:8],
              f"{len(stray)} bean file(s) uncommitted in the shared checkout", ", ".join(stray[:6]))


def check_production_behind(live_sha, tip, now=NOW, live_build=None):
    if not tip:
        return None

    behind_path = f"{STATE}/observe-prod-behind.json"
    deploy_state_path = f"{STATE}/apprunner-deploy-state.json"

    # Check if a deployment is currently in progress / interrupted for this tip
    deploy_in_progress = False
    if os.path.exists(deploy_state_path):
        try:
            with open(deploy_state_path) as handle:
                dstate = json.load(handle)
            if dstate.get("inProgressSha") and dstate.get("inProgressSha").lower() == tip.lower():
                deploy_in_progress = True
        except Exception:
            pass

    has_env_override = False
    if live_build and isinstance(live_build, dict):
        has_env_override = bool(live_build.get("env_override") or live_build.get("envOverride"))

    # Truly converged: live matches tip, no in-progress/failed deploy marker, no disagreement
    if live_sha and live_sha.lower() == tip.lower() and not deploy_in_progress and not has_env_override:
        if not DRY and os.path.exists(behind_path):
            try:
                os.remove(behind_path)
            except Exception:
                pass
        return None

    # Production is behind or probe is failing while tip is known
    first_seen = None
    if os.path.exists(behind_path):
        try:
            with open(behind_path) as handle:
                data = json.load(handle)
            # Continuous divergence: retain first_seen across intermediate deployments and tip movements
            first_seen = data.get("first_seen")
        except Exception:
            pass

    oldest_sha = tip
    if live_sha:
        try:
            commits = git("log", "--format=%H", f"{live_sha}..{tip}").splitlines()
            if commits:
                oldest_sha = commits[-1]
        except Exception:
            pass

    if first_seen is None:
        first_seen = now

    if not DRY:
        try:
            os.makedirs(STATE, exist_ok=True)
            with tempfile.NamedTemporaryFile("w", dir=STATE, prefix="observe-behind-", delete=False) as handle:
                json.dump({"live_sha": live_sha, "tip": tip, "first_seen": first_seen}, handle)
                temp = handle.name
            os.replace(temp, behind_path)
        except Exception:
            pass

    if now - first_seen > 30 * 60:
        mins = int((now - first_seen) / 60)
        return {
            "live": live_sha,
            "tip": tip,
            "oldest_sha": oldest_sha,
            "minutes_behind": mins,
        }
    return None


if __name__ == "__main__":
    board() if "--board" in sys.argv else check()
