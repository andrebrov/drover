#!/usr/bin/env bash
# fleet-dispatch — the one dispatch tool; it cannot hide ready work. See lib/fleet_dispatch.py for the rules.
#   fleet-dispatch [--dry-run]
# shellcheck source=drover-env
_fleet_lib=$(cd "$(dirname "$0")" && pwd)/../lib/fleet_usage.py
_fleet_rc=0
python3 "$_fleet_lib" --gate "$0" "$@" || _fleet_rc=$?
case $_fleet_rc in 10) ;; *) exit $_fleet_rc ;; esac
unset _fleet_lib _fleet_rc

set -a
. "$(dirname "$0")/drover-env"
set +a
export DROVER_PINS_FILE DROVER_LEAD_SEATS DROVER_REFILL_DEDICATED DROVER_BEAN_RE DROVER_BIN FLEET_REPORTS
export FLEET_ROOT="${DROVER_REPO:-}"
[ -n "$FLEET_ROOT" ] || unset FLEET_ROOT
exec python3 "$DROVER_SRC/lib/fleet_dispatch.py" "$@"
