#!/usr/bin/env python3
"""fleet-review-gate — refuse a source-changing landing without a cross-harness APPROVE receipt for what it lands.

  fleet-review-gate check [--head REF] [--base REF] [--author SEAT] <repo-root> <bean>

A receipt is $FLEET_REPORTS/<reviewer>-review-<bean>-by-<coder>.md whose newest verdict is APPROVE and which names
the reviewed commit (`REVIEWED: <sha>`). It covers the head when it is that commit, when every later commit touches
only bean files, or when the head is a byte-identical rebase of it. Refused: no receipt, a newer CHANGES covering the
head, a same-harness reviewer, self-review, a non-seat reviewer name. Accepted receipts are appended to
$FLEET_STATE/review-audit.log; an unwritable audit log refuses. Bean-file-only landings need no receipt.
Exit 0 pass, 4 refused, 2 usage. Run it before `git push origin HEAD:main`; fleet-land-bean runs it itself.
"""
import sys as _fleet_sys
from pathlib import Path as _FleetPath
_fleet_sys.path.insert(0, str(_FleetPath(__file__).resolve().parents[1] / "lib"))
from fleet_usage import gate as _fleet_gate
_fleet_gate(_fleet_sys.argv, __file__)

from fleet_review_gate import main

_fleet_sys.exit(main(_fleet_sys.argv[1:]))
