#!/usr/bin/env bash
# fleet-done — an AGENT calls this the moment it finishes. It is the push half
# of the fleet's reporting: the lead no longer polls, it waits.
#
#   fleet-done <agent> <bean> <DONE|BLOCKED|CHANGES> "<one-line summary>" [report-path]
#
# Writes one line into $FLEET_INBOX. The lead (or fleet-watch) blocks on that
# directory (fleet-wait) instead of reading panes or trusting `fleet status`,
# which reports `done` while an agent is still mid-turn.
set -euo pipefail
# shellcheck source=drover-env
. "$(dirname "$0")/drover-env"
INBOX="$FLEET_INBOX"
mkdir -p "$INBOX"
a="${1:?agent}"; bean="${2:?bean}"; state="${3:?DONE|BLOCKED|CHANGES}"; summary="${4:-}"; report="${5:-}"
# A coder's DONE with unchecked checklist items is not DONE: downgrade to PARTIAL so the watcher
# sends it back to the same coder instead of spending a reviewer round on "items still open".
case "$a" in
  *coder|*coder-[0-9]*)
    bf=$(ls .beans/"$bean"--*.md 2>/dev/null | head -1 || true)   # ls exits 2 on no match: without || true, set -e + pipefail killed the announcement
    if [ "$state" = DONE ] && [ -n "$bf" ]; then
      # grep -c PRINTS 0 and EXITS 1 when there is no match, so `|| echo 0` appended a
      # second zero and `un` became "0\n0" -> "[: integer expression expected". Swallow
      # the status only; never add output. (Same class as the pipefail/grep -q trap.)
      un=$(grep -c '^- \[ \]' "$bf" 2>/dev/null || true); un="${un%%$'\n'*}"
      if [ "${un:-0}" -gt 0 ]; then state=PARTIAL; summary="unchecked items: $un — $summary"; echo "fleet-done: $bean has $un unchecked checklist item(s) → announced as PARTIAL, not DONE" >&2; fi
    fi ;;
esac

# LANDING GATE. In publish-mode=direct a seat may not announce DONE/PARTIAL/READY while THIS BEAN's commits on its current branch (any branch except
# main) are not on origin/main (whole subject or patch; fleet-branch-landed <branch> <bean>). Other beans' commits are not checked.
# The refusal is delivered to the lead as BLOCKED but keeps what the seat wanted: "[wanted DONE] UNLANDED ..." and the report path. Exit 7 tells the seat the steps.
# Exit 2 from the checker (cannot determine) never blocks: the report goes out marked "[landing unverified]". A waiver (FLEET_UNLANDED_OK="<reason>") is per call,
# goes into the summary AND into $FLEET_REPORTS/unlanded-waivers.log with the subjects it covers, so a waived loss is visible, not silent.
if [ "$(cat "$DROVER_PUBLISH_MODE_FILE" 2>/dev/null || echo direct)" = direct ] && { [ "$state" = DONE ] || [ "$state" = PARTIAL ] || [ "$state" = READY ]; }; then
  cur_branch=$(git branch --show-current 2>/dev/null || true)
  if [ -n "$cur_branch" ] && [ "$cur_branch" != main ] && [ "$cur_branch" != master ]; then
    lrc=0; unl=$("$DROVER_BIN/fleet-branch-landed" HEAD "$bean" 2>/dev/null) || lrc=$?     # under set -e a bare unl=$(...) with rc 1 would abort the whole script silently
    if [ "$lrc" = 2 ]; then summary="$summary [landing unverified: fleet-branch-landed could not determine]"
    elif [ "$lrc" = 1 ]; then
      n=$(printf '%s\n' "$unl" | sed 1d | wc -l | tr -d ' ')
      if [ -n "${FLEET_UNLANDED_OK:-}" ]; then
        summary="$summary [UNLANDED WAIVED: ${FLEET_UNLANDED_OK}]"
        mkdir -p "$FLEET_REPORTS"
        printf '%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$a" "$bean" "$FLEET_UNLANDED_OK" "$(printf '%s' "$unl" | sed 1d | tr '\n' ';' | cut -c1-400)" >> "$FLEET_REPORTS/unlanded-waivers.log"
      else
        ts=$(date +%s); printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$ts" "$a" "$bean" BLOCKED "[wanted $state] UNLANDED: $n commit(s) of $bean not on origin/main: $(printf '%s' "$unl" | sed 1d | head -2 | tr '\n' ';' | cut -c1-200) | $summary" "$report" > "$INBOX/$ts-$a-$bean.msg"
        { echo "fleet-done: REFUSED $state: $n commit(s) of $bean are not on origin/main (whole subject or patch):"; printf '%s\n' "$unl" | sed 1d | head -8 | sed 's/^/  - /'
          echo "Land them now: git fetch origin; git rebase --onto origin/main <your base>;${DROVER_TESTDB_UP:+ eval \"\$($DROVER_TESTDB_UP)\";} git push origin HEAD:main (retry up to 3x if main moved); prove: git log origin/main --grep=$bean."
          echo "Then run fleet-done again. If a commit must NOT land: FLEET_UNLANDED_OK=\"<reason>\" (logged in unlanded-waivers.log). Delivered to the lead as BLOCKED with your intended state."; } >&2
        exit 7
      fi
    fi
  fi
fi

ts=$(date +%s)
printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$ts" "$a" "$bean" "$state" "$summary" "$report" \
  > "$INBOX/$ts-$a-$bean.msg"
echo "reported: $a $bean $state"
