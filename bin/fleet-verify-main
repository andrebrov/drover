#!/usr/bin/env python3
"""fleet-verify-main [ref] — verify a clean worktree under one kernel-owned lease.

2026-10-18: a mkdir lock has a publication gap before its PID is written. Never
steal an unknown owner; retain the inode and let the kernel release on death.
"""
import fcntl, os
from pathlib import Path
import subprocess, sys
sys.path.insert(0, str(Path(__file__).resolve().parents[1]/'lib'))
from fleet_usage import gate
gate(sys.argv, __file__)
from fleet_config import configure
config=configure(export=__name__=="__main__")
root=Path(config['FLEET_STATE'])/'verify-wt'
root.mkdir(parents=True,exist_ok=True)
legacy=root/'.gate-lock'
if legacy.is_dir():
    try:
        pid=int((legacy/'pid').read_text())
        if pid <= 0: raise ValueError()
        os.kill(pid,0)
    except ProcessLookupError:
        pass
    except (OSError,ValueError):
        print('verify: legacy lock owner unavailable — refusing duplicate');sys.exit(3)
    else:
        print('verify: another gate is running — skipping duplicate');sys.exit(3)
with (root/'.single-flight.lock').open('a') as lease:
    try: fcntl.flock(lease,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:
        print('verify: another gate is running — skipping duplicate');sys.exit(3)
    # The worker inherits the real lease, so killing this wrapper cannot admit
    # a sibling while the worker still owns its worktree.
    sys.exit(subprocess.call(['bash',str(Path(__file__).resolve().parents[1]/'lib/verify_main.sh'),*sys.argv[1:]],pass_fds=(lease.fileno(),)))
