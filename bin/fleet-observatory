#!/usr/bin/env python3
"""bean-l8ck: local snapshot; no owner actions."""
import sys as _fleet_sys
from pathlib import Path as _FleetPath
_fleet_sys.path.insert(0, str(_FleetPath(__file__).resolve().parents[1] / "lib"))
from fleet_config import configure
config=configure(export=__name__=="__main__")
from fleet_usage import gate as _fleet_gate
_fleet_gate(_fleet_sys.argv, __file__)

from pathlib import Path
import sys

sys.dont_write_bytecode = True

root = Path(__file__).resolve().parents[1]
library = root / 'lib'
if not (library / 'fleet_observatory.py').exists():
    raise SystemExit('UNAVAILABLE: canonical observatory library missing')
sys.path.insert(0, str(library))
from fleet_observatory import main

main()
