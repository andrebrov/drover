#!/usr/bin/env python3
"""fleet-refill — keep idle seats working without the lead.

Every poll (default 60 s):
  1. IDLE = herdr status done/idle AND the visible screen unchanged for IDLE_POLLS polls AND no
     "background work still running" marker on screen. (herdr's `done` is false mid-turn, so status alone is never trusted.)
  2. An idle seat gets the next item from $FLEET_BRIEFS/queue/*.txt (atomic claim by rename). A queue item named
     NNN-assign-<bean>.txt goes through `fleet assign` (a clean branch off origin/main via fleet-prep, the ledger and
     the task file); anything else is sent as a plain prompt. Optional STANDING HUNTS (REFILL_HUNTS=1 and
     DROVER_HUNT_AREAS set) generate proof-or-nothing audit items when the queue is empty; hunters append proven
     findings to the queue as fix items, which fleet-batch groups.
  3. Every 300 s fleet-batch groups fix items and fleet-feed restocks the queue from the focus beans.
  4. Ghost slot waiters (fleet-slot, parent init, cwd gone, > 10 min) are SIGTERMed and logged. Nothing else is killed.
Only seats whose role is coder or reviewer are refilled; a seat with a recent bean-named commit not yet on the main branch is mid-task and HELD, a landing audit nudges the owner of any branch holding unlanded bean commits, and a pinned seat (DROVER_PINS_FILE) is skipped; dedicated seats (DROVER_REFILL_DEDICATED) and seats on a dead
harness (DROVER_REFILL_SKIP_HARNESSES: a harness whose quota is exhausted swallows queue items) are never sent work.
Never sends faster than COOLDOWN per seat, never below MIN_FREE_GB of free disk. Reads only names/cwds, never argv.

Stuck seats: every 5 minutes a seat reported `working` whose worktree (HEAD + status) has not changed for REFILL_STUCK_MIN (45)
minutes is flagged (alerts/stuck.txt, Esc once per signature) and never fed. Only one instance runs (a file lock).

Liveness: each tick has a 600 s SIGALRM watchdog (a loop once went silent for 1h43m with no error and no restart) and a
heartbeat line is logged every 10 ticks; fleet-cred-check treats a log older than 10 minutes as DEAD.

  fleet-refill --once --dry-run     show decisions, change nothing
  fleet-refill                      run forever
Env: REFILL_POLL (60) REFILL_IDLE_POLLS (4) REFILL_COOLDOWN (900) REFILL_MIN_FREE_GB (30) REFILL_MAX_SENDS (4)
     REFILL_MAX_WAITERS (8) REFILL_SOFT_POLLS (12) REFILL_HUNTS REFILL_FEED_EVERY (300) REFILL_TICK_LIMIT (600)
"""

import sys as _fleet_sys
from pathlib import Path as _FleetPath
_fleet_sys.path.insert(0, str(_FleetPath(__file__).resolve().parents[1]/"lib"))
from fleet_usage import gate as _fleet_gate
_fleet_gate(_fleet_sys.argv, __file__)
import fcntl, glob, hashlib, json, os, re, signal, subprocess, sys, time


def drover_env():
    """The same config every bash script sees: source drover-env (next to this file) and read it back."""
    here = os.path.dirname(os.path.abspath(__file__))
    env = os.path.join(here, 'drover-env')
    keys = ['DROVER_BIN', 'DROVER_HOME', 'DROVER_ROSTER', 'DROVER_BEAN_RE', 'FLEET_BRIEFS', 'FLEET_REPORTS', 'FLEET_REFILL_LOG',
            'DROVER_REFILL_DEDICATED', 'DROVER_REFILL_SKIP_HARNESSES', 'DROVER_HUNT_AREAS', 'DROVER_WORKTREES', 'DROVER_PINS_FILE', 'DROVER_MID_TASK_MIN', 'FLEET_STATE', 'DROVER_REPO', 'DROVER_TESTDB_UP']
    out = subprocess.run(['bash', '-c', '. "$0"; for k in "$@"; do printf "%s=%s\\0" "$k" "${!k:-}"; done', env, *keys],
                         capture_output=True, text=True, check=True).stdout
    return dict(kv.split('=', 1) for kv in out.split('\0') if '=' in kv)


E = drover_env()
BIN = E['DROVER_BIN']
QDIR = f"{E['FLEET_BRIEFS']}/queue"
CLAIMED = f"{E['FLEET_BRIEFS']}/queue-claimed"
STATE = f"{E['DROVER_HOME']}/refill/state.json"
LOG = E['FLEET_REFILL_LOG']
REPORTS = E['FLEET_REPORTS']
BEAN_RE = E['DROVER_BEAN_RE']

ROSTER = [p.split(':') for p in E['DROVER_ROSTER'].split() if ':' in p]
DEDICATED = set(E['DROVER_REFILL_DEDICATED'].split())
SKIP_HARNESS = set(E['DROVER_REFILL_SKIP_HARNESSES'].split())
CODERS = [n for n, h in ROSTER if n.rsplit('-', 1)[-1] == 'coder' and n not in DEDICATED and h not in SKIP_HARNESS]
REVIEWERS = [n for n, h in ROSTER if n.rsplit('-', 1)[-1] in ('reviewer', 'analyst') and n not in DEDICATED and h not in SKIP_HARNESS]
SEATS = CODERS + REVIEWERS
SEATS_ALL = [n for n, h in ROSTER if n.rsplit('-', 1)[-1] in ('coder', 'reviewer', 'analyst') and n not in DEDICATED]   # stuck detection covers every seat, even on a skipped harness
STUCK_MIN = int(os.environ.get('REFILL_STUCK_MIN', '45'))   # `working` with no change in its worktree this long = stuck, not working
SEATS += [x for x in os.environ.get('REFILL_EXTRA_SEATS', '').split(',') if x]   # test hook only

POLL = int(os.environ.get('REFILL_POLL', '60'))
IDLE_POLLS = int(os.environ.get('REFILL_IDLE_POLLS', '4'))
COOLDOWN = int(os.environ.get('REFILL_COOLDOWN', '900'))
MIN_FREE_GB = float(os.environ.get('REFILL_MIN_FREE_GB', '30'))      # a full disk once hung the machine: never send work below this
MAX_SENDS = int(os.environ.get('REFILL_MAX_SENDS', '4'))
MAX_WAITERS = int(os.environ.get('REFILL_MAX_WAITERS', '8'))         # more fleet-slot processes than this = the heavy lane is saturated
SOFT_POLLS = int(os.environ.get('REFILL_SOFT_POLLS', '12'))          # a screen unchanged this long is idle even with a soft hint
FEED_EVERY = int(os.environ.get('REFILL_FEED_EVERY', '300'))
TICK_LIMIT = int(os.environ.get('REFILL_TICK_LIMIT', '600'))
HARD = re.compile(r'esc to interrupt|esc interrupt|Working \(|\(\d+m \d+s|\(\d+s ', re.I)   # live work: timers and the interrupt hint
SOFT = re.compile(r'\b[1-9]\d* (shell|shells|monitor|monitors|task|tasks)\b|background terminal|still running|ctrl\+b to run in background', re.I)   # a background job may still run
WORKTREES = E['DROVER_WORKTREES']
PINS_FILE = E['DROVER_PINS_FILE']
MID_TASK_S = int(E['DROVER_MID_TASK_MIN'] or '90') * 60
STATE_DIR = E['FLEET_STATE']
REPO = E['DROVER_REPO']
TESTDB_UP = E['DROVER_TESTDB_UP']
AUDIT_EVERY = int(os.environ.get('REFILL_AUDIT_EVERY', '600'))
NUDGE_MIN = int(os.environ.get('REFILL_NUDGE_MIN', '30'))      # a branch with unlanded bean commits this old is nudged once per tip
ALERT_MIN = int(os.environ.get('REFILL_ALERT_MIN', '60'))      # this old: written to alerts/unlanded.txt (fleet-preflight turns it into DEAD)
PRE_EVERY = int(os.environ.get('REFILL_PREFLIGHT_EVERY', '600'))
ASSIGN_ITEM = re.compile(r'QUEUE \d*-?assign-(' + BEAN_RE + ')')

AREAS = [a.strip() for a in E['DROVER_HUNT_AREAS'].split(';') if a.strip()]
CLASSES = [('cross-tenant leakage', 'data of one customer read through a shared path, or an id resolved to a shared account'),
           ('gate that passes when evidence is missing', 'a fail-open guard in an approval, delivery or send path'),
           ('test that cannot fail', 'a partial mock, a self-grading constant or a source-text assertion; prove it with a mutation that leaves the suite green'),
           ('number with no basis', 'a percentage or delta shown to a user with no stated comparison window or sample size'),
           ('swallowed failure counted as success', 'catch-and-continue while the caller records the run as succeeded'),
           ('absence reported as a value', 'null/NaN/undefined/0 shipped as a real figure, or a stringified null')]


def log(msg):
    line = f"{time.strftime('%F %T')} {msg}"
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, 'a') as f:
        f.write(line + '\n')
    print(line, flush=True)


class Watchdog(BaseException):
    """Raised by the tick alarm. A BaseException so no `except Exception` inside a helper can swallow it."""


def run(cmd, timeout=20, cwd=None):
    """Run a command in its own process group; on timeout kill the WHOLE group (a child's children used to survive and pile up)."""
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True, cwd=cwd)
    except Exception as e:
        return subprocess.CompletedProcess(cmd, 1, '', str(e))
    try:
        out, err = p.communicate(timeout=timeout)
        return subprocess.CompletedProcess(cmd, p.returncode, out, err)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except Exception:
            pass
        out, err = p.communicate()
        return subprocess.CompletedProcess(cmd, 124, out or '', (err or '') + ' [timeout]')
    except Watchdog:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except Exception:
            pass
        raise


def load():
    try:
        return json.load(open(STATE))
    except Exception:
        return {'seats': {}, 'hunt': 0}


def save(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    json.dump(s, open(STATE + '.tmp', 'w'))
    os.replace(STATE + '.tmp', STATE)


def seat_view(name):
    g = run(['herdr', 'agent', 'get', name])
    if g.returncode != 0:
        return None
    try:
        status = json.loads(g.stdout)['result']['agent']['agent_status']
    except Exception:
        return None
    scr = run(['herdr', 'agent', 'read', name, '--source', 'visible', '--lines', '40']).stdout
    return status, scr


def next_item(kind, seat, st, light=False):
    os.makedirs(QDIR, exist_ok=True)
    os.makedirs(CLAIMED, exist_ok=True)
    for p in ([] if light else sorted(glob.glob(f'{QDIR}/*.txt'))):
        try:
            text = open(p).read()
        except Exception:
            continue
        m = re.match(r'kind:\s*(coder|reviewer|any)\s*\n', text)
        k = m.group(1) if m else 'any'
        if k not in ('any', kind):
            continue
        dst = f'{CLAIMED}/{os.path.basename(p)}'
        try:
            os.rename(p, dst)                       # atomic claim: the loser gets FileNotFoundError
        except Exception:
            continue
        body = text[m.end():] if m else text
        return f'QUEUE {os.path.basename(p)}', body.strip()
    if os.environ.get('REFILL_HUNTS') != '1' or not AREAS:      # hunts are opt-in: no new work is generated by default
        return None, None
    i = st.get('hunt', 0)
    st['hunt'] = i + 1
    area = AREAS[i % len(AREAS)]
    cls, what = CLASSES[(i // len(AREAS) + i) % len(CLASSES)]
    n = i + 1
    rep = f'{REPORTS}/{seat}-standing-{n}-{time.strftime("%Y%m%d")}.md'
    qfix = f'{QDIR}/fix-{seat}-standing-{n}-<k>.txt'
    body = (f'STANDING HUNT #{n}: class "{cls}" ({what}) in the area "{area}". PROOF OR NOTHING: each finding = file:line + the triggering input + the '
            f'wrong output, shown by running the real code in a throwaway copy (deleted after). An honest empty hunt is a valid result, say so. Read-only; do not fix. '
            f'Report to {rep} (first line HUNT + count of proven findings). For EACH proven finding also write one fix item file {qfix} '
            f'(k = 1,2,...) whose content is exactly: "kind: coder" newline, then one paragraph: the finding with file:line, the trigger, the wrong output, '
            f'the root-cause fix wanted, and "Fix at the shared function with a test that fails before and passes after (revert-test-restore on a per-file copy); '
            f'fresh worktree off origin/main; push only your own commits through the normal hook; heavy runs inside fleet-slot; no new beans; report then fleet-done." '
            f'Then fleet-done. Do not wait for the lead.')
    if cls == 'test that cannot fail':   # vacuous tests are removed, not strengthened
        body = body.replace('the root-cause fix wanted, and "Fix at the shared function with a test that fails before and passes after (revert-test-restore on a per-file copy); ',
                            'the fix wanted is to DELETE the vacuous test or assertion (tests that cannot fail are removed, not strengthened), and "Delete ONLY that test or assertion, never other tests in the file. '
                            'First prove it cannot fail: mutate the code it claims to cover on a per-file copy and show the suite stays green, and paste that. After deleting, the file still compiles and its remaining tests pass; ')
    if light:
        body += (' THE HEAVY TEST LANE IS SATURATED RIGHT NOW: do NOT run the test runner, the type checker or a build; probe with a small script '
                 '(under 60 s) or by reading the code; if a proof needs a real test run, write the finding with the exact command and leave the heavy run to the fix item.')
    return f'HUNT #{n} {cls} / {area}' + (' [light]' if light else ''), body


def _check(wt, bean=''):
    """fleet-branch-landed run inside a seat worktree -> (rc, oldest_min, newest_min, subjects)."""
    # argv + cwd, never a shell string: the bean and the path come from ref names and config, and a ref name may contain $(...) or backticks
    r = run([f'{BIN}/fleet-branch-landed', 'HEAD'] + ([bean] if bean else []), timeout=60, cwd=wt)
    lines = r.stdout.splitlines()
    old = new_ = 0
    subs = []
    if r.returncode == 1 and lines and lines[0].startswith('AGE'):
        m = re.match(r'AGE (\d+) NEWEST (\d+)', lines[0])
        old, new_ = (int(m.group(1)), int(m.group(2))) if m else (0, 0)
        subs = lines[1:]
    return r.returncode, old, new_, subs


def mid_task(seat, st=None):
    """A quiet screen is not idle: a seat whose branch has bean-named commits NOT on origin/main (whole subject or patch, never SHA ancestry), the
    newest under DROVER_MID_TASK_MIN old, is mid-task and is never fed new work. Cached per HEAD sha for 5 minutes so the loop stays cheap."""
    wt = f'{WORKTREES}/fleet-{seat}'
    if not os.path.isdir(wt):
        return False
    head = run(['git', '-C', wt, 'rev-parse', 'HEAD'], timeout=10).stdout.strip()
    cache = st.setdefault('mt', {}) if st is not None else {}
    c = cache.get(seat)
    if c and c['head'] == head and time.time() - c['at'] < 300:
        return c['v']
    rc, old, newest, subs = _check(wt)
    v = (rc == 1 and newest < MID_TASK_S // 60)
    if st is not None:
        cache[seat] = {'head': head, 'at': time.time(), 'v': v}
    return v


def landing_audit(st, now, dry=False):
    """Every fleet/<seat>-<bean> branch (14 days) with bean commits not on origin/main (whole subject or patch):
    - STAGNANT (newest unlanded commit ALERT_MIN+ minutes old) -> alert, oldest first; a seat still committing is not escalated;
    - older than 14 days -> archive candidate, never DEAD;
    - nudged ONLY if the seat is currently on that branch, is not mid-task, at most one nudge per seat per 60 min, one per branch tip, and a
      failed send is not recorded as delivered;
    - a branch the checker cannot determine (rc 2) leaves the audit INCOMPLETE: no .ok stamp, so fleet-preflight reports it stale, not clean."""
    if not REPO:
        return
    out = run(['git', '-C', REPO, 'for-each-ref', '--format=%(refname:short) %(committerdate:unix)', 'refs/heads/fleet/'], timeout=30).stdout.splitlines()
    nudged = st.setdefault('nudged', {})
    seat_nudge = st.setdefault('seat_nudge', {})
    rows = []
    incomplete = False
    for line in out:
        br, _, ts = line.partition(' ')
        m = re.match(r'fleet/(.+)-(' + BEAN_RE + r')$', br)
        if not m or not ts.isdigit() or now - int(ts) > 14 * 86400:
            continue
        seat, bean = m.groups()
        r = run([f'{BIN}/fleet-branch-landed', br, bean], timeout=60, cwd=REPO)    # argv, not a shell string: a ref name may contain $(...)
        if r.returncode == 0:
            continue
        if r.returncode != 1:
            incomplete = True
            log(f'landing audit: cannot determine {br} (rc={r.returncode})')
            continue
        lines = r.stdout.splitlines()
        mm = re.match(r'AGE (\d+) NEWEST (\d+)', lines[0]) if lines else None
        old, newest = (int(mm.group(1)), int(mm.group(2))) if mm else (0, 0)
        rows.append((old, newest, br, seat, bean, lines[1:]))
    rows.sort(reverse=True)
    alerts = [f'{br}: {len(subs)} unlanded, oldest {old} min, newest {newest} min' for old, newest, br, seat, bean, subs in rows if newest >= ALERT_MIN]
    for old, newest, br, seat, bean, subs in rows:
        if newest < NUDGE_MIN or seat not in SEATS:
            continue
        tip = run(['git', '-C', REPO, 'rev-parse', '--short', br], timeout=10).stdout.strip()
        cur = run(['git', '-C', f'{WORKTREES}/fleet-{seat}', 'branch', '--show-current'], timeout=10).stdout.strip()
        if cur != br or nudged.get(br) == tip or now - seat_nudge.get(seat, 0) < 3600 or mid_task(seat, st):
            continue
        msg = (f'LANDING AUDIT: {len(subs)} commit(s) of {bean} on {br} are not on origin/main (oldest {old} min, newest {newest} min), e.g. "{subs[0][:80]}". '
               f'Land the green ones now (git fetch; git rebase --onto origin/main <base>;' + (f' eval "$({TESTDB_UP})";' if TESTDB_UP else '') +
               f' git push origin HEAD:main; prove git log origin/main --grep={bean}); then fleet-done. If one must not land, say why in the report.')
        if dry:
            log(f'DRY nudge {seat} {bean}')
            continue
        rr = run([f'{BIN}/fleet', 'followup', seat, msg], timeout=60)
        if rr.returncode == 0:
            nudged[br] = tip
            seat_nudge[seat] = now
            log(f'NUDGE {seat} {bean}: {len(subs)} unlanded, newest {newest} min')
        else:
            log(f'NUDGE FAILED {seat} {bean} rc={rr.returncode}')
    if dry:
        return
    if incomplete: log('landing audit: incomplete; no scoreboard observation published')


def stuck_check(st, now, dry=False):
    """A seat that herdr reports `working` but whose worktree (HEAD + git status) has not changed for STUCK_MIN minutes is stuck, not working
    (a seat once sat 5 h in a "Let me go. Let me run." loop on an unresolved merge while the status said working). Alert, and send Esc ONCE per
    signature. Flagged seats are written to alerts/stuck.txt and are never fed new work (a looping seat is restarted, not fed). The .ok stamp says
    the check completed; fleet-preflight treats a missing or old stamp as DEAD."""
    alerts = []
    sig = st.setdefault('sig', {})
    for seat in SEATS_ALL:
        v = seat_view(seat)
        if v is None or v[0] != 'working':
            sig.pop(seat, None)
            continue
        wt = f'{WORKTREES}/fleet-{seat}'
        if not os.path.isdir(wt):
            continue
        h = run(['git', '-C', wt, 'rev-parse', 'HEAD'], timeout=10).stdout.strip()
        d = run(['git', '-C', wt, 'status', '--porcelain'], timeout=20).stdout
        merging = run(['git', '-C', wt, 'rev-parse', '-q', '--verify', 'MERGE_HEAD'], timeout=10).returncode == 0
        cur = hashlib.sha1((h + d).encode()).hexdigest()
        old = sig.get(seat)
        if not old or old['sig'] != cur:
            sig[seat] = {'sig': cur, 'since': now, 'acted': False}
            continue
        mins = (now - old['since']) / 60
        if mins >= STUCK_MIN:
            alerts.append(f'{seat}: working {mins:.0f} min with no change in its worktree' + (' (UNRESOLVED MERGE)' if merging else ''))
            if not old['acted'] and not dry:
                run(['herdr', 'agent', 'send-keys', seat, 'esc'], timeout=15)
                old['acted'] = True
                log(f'STUCK {seat}: {mins:.0f} min no worktree change' + (' with an unresolved merge' if merging else '') + '; sent Esc')
    if dry:
        return
    d = f'{STATE_DIR}/alerts'
    os.makedirs(d, exist_ok=True)
    open(f'{d}/stuck.txt', 'w').write('\n'.join(alerts) + ('\n' if alerts else ''))
    open(f'{d}/stuck.txt.ok', 'w').write(str(int(now)))


def reap_ghosts(dry):
    r = run(['pgrep', '-f', 'fleet-slot'])
    for pid in [int(x) for x in r.stdout.split() if x.isdigit()]:
        ps = run(['ps', '-o', 'ppid=,etime=', '-p', str(pid)]).stdout.split()
        if len(ps) < 2 or ps[0] != '1':
            continue
        et = ps[1]
        parts = re.split('[-:]', et)
        mins = int(parts[-2]) + 60 * int(parts[-3] if len(parts) > 2 else 0) + 1440 * (int(parts[0]) if '-' in et else 0)
        if mins < 10:
            continue
        cwd = [l[1:] for l in run(['lsof', '-a', '-p', str(pid), '-d', 'cwd', '-Fn']).stdout.splitlines() if l.startswith('n')]
        if not cwd or os.path.isdir(cwd[0]):
            continue                                   # cwd still exists: a live seat's own job, never touched
        msg = f'GHOST fleet-slot waiter pid={pid} ppid=1 etime={et} cwd gone'
        if dry:
            log('DRY ' + msg)
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except Exception as e:
            log(f'{msg} kill failed: {e}')
            continue
        log('REAP ' + msg)


def tick(dry):
    st = load()
    sends = 0
    now = time.time()
    free = os.statvfs(os.path.expanduser('~'))
    free_gb = free.f_bavail * free.f_frsize / 2**30
    if free_gb < MIN_FREE_GB:
        log(f'DISK GUARD: only {free_gb:.1f} GB free (< {MIN_FREE_GB}): no new work sent')
        return
    if now - st.get('stuck', 0) > 300:
        st['stuck'] = now
        try:
            stuck_check(st, now, dry)
        except Exception as e:
            log(f'stuck check error: {e!r}')
    if now - st.get('audit', 0) > AUDIT_EVERY:           # landing audit: finished work must reach the main branch; nudge the owner once per tip, escalate later
        st['audit'] = now
        try:
            landing_audit(st, now, dry)
        except Exception as e:
            log(f'landing audit error: {e!r}')
    if now - st.get('pre', 0) > PRE_EVERY:              # the silent dependencies, each a check that can fail (mode vs lander, credentials, production lag)
        st['pre'] = now
        r = run([f'{BIN}/fleet-preflight'], timeout=120)
        if r.returncode in (0, 1) and not dry:
            dead = [l for l in r.stdout.splitlines() if l.startswith('DEAD')]
            os.makedirs(f'{STATE_DIR}/alerts', exist_ok=True)
            open(f'{STATE_DIR}/alerts/preflight.txt', 'w').write('\n'.join(dead) + ('\n' if dead else ''))
            for l in dead:
                log('PREFLIGHT ' + l[:200])
        elif r.returncode not in (0, 1):
            log(f'PREFLIGHT could not run (rc={r.returncode}); previous alerts kept')
    r = run([f'{BIN}/fleet-batch'])                    # group fix items by area so one seat fixes, tests and pushes a whole group once
    if r.returncode != 0:
        log(f'fleet-batch failed rc={r.returncode}: {r.stderr.strip()[:150]}')
    if now - st.get('feed', 0) > FEED_EVERY:           # nobody works when the lead is away: restock the queue from the focus beans
        st['feed'] = now
        r = run([f'{BIN}/fleet-feed'], timeout=150) if not dry else subprocess.CompletedProcess([], 0, '', '')
        if r.stdout.strip():
            log('fleet-feed: ' + r.stdout.strip().replace('\n', '; ')[:300])
        if r.returncode != 0:
            log(f'fleet-feed failed rc={r.returncode}: {r.stderr.strip()[:150]}')
    waiters = len([x for x in run(['pgrep', '-f', 'fleet-slot']).stdout.split() if x.isdigit()])
    light = waiters > MAX_WAITERS
    if light:
        log(f'backpressure: {waiters} fleet-slot processes (> {MAX_WAITERS}): light work only, no queue fix items')
    pins = set()
    try:
        pins = {l.split()[0] for l in open(PINS_FILE) if l.strip() and not l.startswith('#')}
    except OSError:
        pass
    stuck_seats = set()
    try:
        stuck_seats = {l.split(':')[0] for l in open(f'{STATE_DIR}/alerts/stuck.txt') if ':' in l}
    except OSError:
        pass
    for seat in SEATS:
        if seat in pins:
            continue
        if seat in stuck_seats:
            continue          # a seat the stuck check flagged is looping, not idle: never feed it (restart it)
        if mid_task(seat, st):
            log(f'HOLD {seat}: unlanded bean commits in the last {MID_TASK_S // 60} min (mid-task, not idle)')
            continue
        v = seat_view(seat)
        s = st['seats'].setdefault(seat, {'hash': '', 'same': 0, 'last_send': 0})
        if v is None:
            s['same'] = 0
            continue
        status, scr = v
        h = hashlib.sha1(scr.encode()).hexdigest()
        hard = bool(HARD.search(scr))
        soft = bool(SOFT.search(scr))
        s['same'] = s['same'] + 1 if (h == s['hash'] and not hard) else 0
        s['hash'] = h
        idle = status in ('done', 'idle') and not hard and s['same'] >= IDLE_POLLS and (not soft or s['same'] >= SOFT_POLLS)
        if status == 'working' or hard:
            s['same'] = 0
        if not idle or sends >= MAX_SENDS or now - s['last_send'] < COOLDOWN:
            continue
        kind = 'coder' if seat in CODERS else 'reviewer'
        what, body = next_item(kind, seat, st, light) if not dry else ('(dry) next item', '')
        if what is None:
            continue                                   # queue empty and hunts are off
        if dry:
            log(f'DRY would refill {seat} ({status}, unchanged {s["same"]} polls): {what}')
            continue
        body += (' CLEANUP: when this item is finished and pushed/landed, remove the fresh worktree YOU created: '
                 'git worktree remove <path> (no --force; it refuses if anything is unsaved) and delete any scratch copy you made. Never leave a worktree behind.')
        mb = ASSIGN_ITEM.match(what or '')
        if mb:   # a bean slice item: go through fleet assign so the seat gets a clean branch off origin/main (fleet-prep) and the ledger/task file
            r = run([f'{BIN}/fleet', 'assign', mb.group(1), seat, body], timeout=240)
        else:
            r = run([f'{BIN}/fleet', 'send', seat, body], timeout=60)
        if r.returncode == 0:
            s['last_send'] = now
            s['same'] = 0
            sends += 1
            log(f'REFILL {seat} <- {what}')
        else:
            log(f'send to {seat} failed rc={r.returncode}: {(r.stdout + r.stderr).strip()[:150]}')
    reap_ghosts(dry)
    save(st)


def main():
    dry = '--dry-run' in sys.argv
    once = '--once' in sys.argv
    lockdir = os.path.dirname(STATE)
    os.makedirs(lockdir, exist_ok=True)
    lock = open(f'{lockdir}/refill.lock', 'a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print('fleet-refill: another instance holds the lock; exiting')   # two ticks lost state and collided on the temp file
        sys.exit(0)
    log(f'start poll={POLL}s idle_polls={IDLE_POLLS} cooldown={COOLDOWN}s dry={dry} seats={len(SEATS)}')

    def _wd(signum, frame):
        raise Watchdog(f'tick watchdog: a tick ran longer than {TICK_LIMIT} s')
    signal.signal(signal.SIGALRM, _wd)
    n = 0
    while True:
        signal.alarm(TICK_LIMIT)    # no single tick may outlive this: a hung child once made the loop go silent for 1h43m
        try:
            tick(dry)
        except BaseException as e:
            log(f'tick error: {e!r}')
        finally:
            signal.alarm(0)
        n += 1
        if n % 10 == 0:
            log(f'heartbeat: {n} ticks')
        if once:
            break
        time.sleep(POLL)


if __name__ == '__main__':
    main()
